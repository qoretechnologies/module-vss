%requires qore >= 2.0
%requires(reexport) DataProvider
%requires VssLoader

%modern

module VssDataProcessors {
    version = "1.0";
    desc = "COVESA VSS pipeline data processors for telemetry normalization";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-vss";
    license = "MIT";
}

