%requires qore >= 2.0
%requires(reexport) DataProvider
%requires VssLoader

%modern

module VssDataProvider {
    version = "1.0";
    desc = "COVESA VSS catalog data provider";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-vss";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new VssDataProviderFactory());
    };
}

/** @mainpage VssDataProvider Module

    @section vssdpintro Introduction

    The %VssDataProvider module provides DataProvider integration for COVESA VSS
    catalogs, enabling browsable tree navigation and data validation through
    Qore's data provider framework.

    @section vssdpclasses Classes

    - @ref VssDataProvider::VssDataProviderFactory "VssDataProviderFactory"
    - @ref VssDataProvider::VssRootDataProvider "VssRootDataProvider"
    - @ref VssDataProvider::VssCatalogDataProvider "VssCatalogDataProvider"
    - @ref VssDataProvider::VssSignalDataProvider "VssSignalDataProvider"
    - @ref VssDataProvider::VssValidationDataProvider "VssValidationDataProvider"
*/

public namespace VssDataProvider {
}
