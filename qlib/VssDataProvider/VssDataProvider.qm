%requires qore >= 3.0
%requires(reexport) DataProvider
%requires FileLocationHandler
%requires VssLoader

%try-module yaml
%define NoYaml
%endtry

%try-module json
%define NoJson
%endtry

%modern

module VssDataProvider {
    version = "1.0";
    desc = "COVESA VSS catalog data provider and pipeline processors";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-vss";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new VssDataProviderFactory());

        # Register VSS app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": VssDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "VSS Data",
            "short_desc": "Ingest and process vehicle signal telemetry data",
            "desc": "Ingest, validate, and transform vehicle telemetry data using the COVESA Vehicle "
                "Signal Specification (VSS) standard for fleet analytics and IoT applications",
            "logo": VssDataProvider::VssLogo,
            "logo_file_name": "vss-logo.svg",
            "logo_mime_type": MimeTypeSvg,
            "groups": (DataProvider::AppGroup::Iot, DataProvider::AppGroup::DataTransformation),
        });

        # Register DPAT_FIND action for reading VSS data
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": VssDataProvider::AppName,
            "path": "/",
            "action": "read",
            "subtype": "vssread",
            "display_name": "Read VSS Data",
            "short_desc": "Read vehicle telemetry records from a data file",
            "desc": "Reads vehicle signal telemetry records from a JSON or YAML data file for "
                "processing in data pipelines",
            "action_code": DPAT_FIND,
            "cls": "VssDataProvider::VssReadDataProvider",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                VssReadDataProvider::ConstructorOptions{"path", "format"}, {
                    "preselected": True,
                    "required": True,
                    "loc": "constructor",
                }
            ),
        });
    };
    # PROCESS_CONTROL: its init registers data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage VssDataProvider Module

    @section vssdataproviderintro VssDataProvider Module Introduction

    <img src="vss-logo.svg" width="96" alt="VssDataProvider module logo"/>

    The %VssDataProvider module provides DataProvider integration for COVESA VSS
    catalogs, enabling browsable tree navigation, data validation, telemetry
    ingestion, and pipeline processing through Qore's data provider framework.

    @section vssdataproviderquickstart Quick Start

    @par Catalog Browsing and Signal Validation
    @code{.py}
    %requires VssDataProvider

    # Create provider via the factory
    AbstractDataProviderFactory factory = DataProvider::getFactory("vss");
    AbstractDataProvider root = factory.create({
        "catalog_path": "/opt/fleet/vss_rel_4.0.yaml",
    });

    # Browse the VSS catalog tree
    AbstractDataProvider speed = root.getChildProvider("catalog")
        .getChildProvider("Vehicle").getChildProvider("Speed");
    hash<auto> meta = speed.doRequest({});
    printf("Speed: %s %s\n", meta.datatype, meta.unit); # float km/h

    # Validate telemetry values
    hash<auto> result = root.getChildProvider("validate").doRequest({
        "path": "Vehicle.Speed",
        "value": 85,
    });
    @endcode

    @par Fleet Telemetry Data Pipeline
    @code{.py}
    # Read telemetry → normalize → validate → convert units → enrich
    VssReadDataProvider reader({"path": "file:///data/fleet/truck-42.json"});
    VssTree tree("/opt/fleet/vss_rel_4.0.yaml");
    VssUnitConverter converter();

    list<AbstractDataProcessor> pipeline = (
        new VssNormalizeProcessor({"veh_spd": "Vehicle.Speed", "ect": "Vehicle.Powertrain.CombustionEngine.ECT"}),
        new VssValidateProcessor(tree, True),
        new VssUnitConvertProcessor(converter, {"Vehicle.Speed": {"from_unit": "km/h", "to_unit": "mph"}}),
        new VssEnrichProcessor({"fleet_id": "EU-WEST-42", "vin": "WBA3A5C55CF256789"}),
    );
    @endcode

    @section vssdataproviderclasses Data Provider Classes

    - @ref VssDataProvider::VssDataProviderFactory "VssDataProviderFactory" - Factory
      for creating VSS catalog data providers
    - @ref VssDataProvider::VssRootDataProvider "VssRootDataProvider" - Root provider
      with \c "catalog" and \c "validate" children
    - @ref VssDataProvider::VssCatalogDataProvider "VssCatalogDataProvider" - Browsable
      VSS signal tree
    - @ref VssDataProvider::VssSignalDataProvider "VssSignalDataProvider" - Leaf signal
      metadata provider
    - @ref VssDataProvider::VssValidationDataProvider "VssValidationDataProvider" -
      Request-response validation provider
    - @ref VssDataProvider::VssReadDataProvider "VssReadDataProvider" - Streaming
      read provider for JSON/YAML telemetry files (DPAT_FIND)

    @section vssdataproviderprocessors Pipeline Processors

    - @ref VssDataProvider::VssNormalizeProcessor "VssNormalizeProcessor" - Renames
      OEM fields to standardized VSS paths
    - @ref VssDataProvider::VssValidateProcessor "VssValidateProcessor" - Validates
      records against VSS catalog (filter or annotate mode)
    - @ref VssDataProvider::VssUnitConvertProcessor "VssUnitConvertProcessor" - Converts
      signal values between measurement units
    - @ref VssDataProvider::VssEnrichProcessor "VssEnrichProcessor" - Adds fleet
      metadata and timestamps to records

    @section vssdataprovidertypes Types

    - @ref VssDataProvider::VssSignalResponseDataType "VssSignalResponseDataType" -
      Signal metadata response fields
    - @ref VssDataProvider::VssValidationRequestDataType "VssValidationRequestDataType" -
      Validation request fields (path + value)
    - @ref VssDataProvider::VssValidationResponseDataType "VssValidationResponseDataType" -
      Validation response fields (valid + errors)

    @section vssdp_caller_paths Paths Given by Restricted Callers

    The code of this module runs with its own %Program's options, so it decides with the restrictions of the code that
    calls it before it reads a file whose path that code gives: if that code is restricted from the \c FILESYSTEM
    functional domain (for example with \c PO_NO_FILESYSTEM), the provider is not created and the call is refused with
    \c PERMISSION-DENIED before anything is read.  The file-system policy of a sandbox that governs the calling code
    applies when a file is opened (\c FILESYSTEM-ACCESS-DENIED).  The checked paths are:
    - the \c catalog_path option of @ref VssDataProvider::VssRootDataProvider "VssRootDataProvider", also when the
      provider is created with a @ref VssDataProvider::VssDataProviderFactory "VssDataProviderFactory" that the host
      created and gave to the restricted code (the code that the factory was lent to is judged, see
      @ref Qore::SandboxManager::isLentToRestricted() "SandboxManager::isLentToRestricted()")
    - the paths that the classes of the @ref vssloader_caller_paths "VssLoader" module are given

    The \c path option of @ref VssDataProvider::VssReadDataProvider "VssReadDataProvider" is a location that
    \c FileLocationHandler reads when records are searched; it refuses a
    caller restricted from a functional domain of the location's handler (\c FILESYSTEM for \c file:// locations
    and paths), including the code of a provider that restricted code created; a provider that the host created and
    gave to restricted code reads the host's path, which its subclasses cannot change.  Providers created from data
    (the \c stream and \c data options of @ref VssDataProvider::VssReadDataProvider "VssReadDataProvider") work for
    restricted callers.

    @subpage vssdataproviderreleasenotes
*/

/** @page vssdataproviderreleasenotes VssDataProvider Release Notes

    @section vssdataproviderv10 VssDataProvider Module Version 1.0
    - initial release
    - the \c catalog_path option is refused with \c PERMISSION-DENIED before it is used if the calling code is
      restricted from the file system, also when the host created the factory and gave it to that code (see
      @ref vssdp_caller_paths, <a href="https://github.com/qoretechnologies/module-vss/issues/4">issue 4</a>)
*/

public namespace VssDataProvider {
    #! Application name for the DataProvider action catalog
    public const AppName = "VSS";

    #! VSS app logo (SVG)
    public const VssLogo = File::readTextFile(get_script_dir() + "/vss-logo.svg");

    #! Refuses a file-system path given by the calling code if that code is restricted from the file system
    /** Library code runs with its own %Program's options, so a path that the calling code gives is refused before it
        is used if that code is restricted from the \c FILESYSTEM functional domain (for example with
        \c PO_NO_FILESYSTEM); see @ref vssdp_caller_paths.

        @param field the name of the option, for the error message
        @param path the path; no check is made if it is not set (any value that is set is checked, also an empty
        string and one that evaluates to @ref False, such as \c "0")
        @param lent @ref True if the path is an argument of a method of an existing object, which a host can lend to
        restricted code (the borrower is judged, see @ref Qore::SandboxManager::isLentToRestricted()
        "SandboxManager::isLentToRestricted()"), @ref False if it is given when an object is created (the creating
        code is judged, see @ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()")

        @throw PERMISSION-DENIED the calling code is restricted from the \c FILESYSTEM functional domain
    */
    sub vss_dp_check_caller_path(string field, auto path, bool lent) {
        if (exists path && (lent
                ? SandboxManager::isLentToRestricted(DOM_FILESYSTEM)
                : SandboxManager::isCallerRestricted(DOM_FILESYSTEM))) {
            throw "PERMISSION-DENIED", sprintf("the %y option cannot be used: the calling code is restricted from the "
                "FILESYSTEM functional domain", field);
        }
    }
}
