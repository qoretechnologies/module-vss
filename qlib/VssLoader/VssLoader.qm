%requires qore >= 3.0
%requires Util

%try-module yaml
%define NoYaml
%endtry

%try-module json
%define NoJson
%endtry

%modern

module VssLoader {
    version = "1.0";
    desc = "COVESA Vehicle Signal Specification (VSS) loader and validator";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-vss";
    license = "MIT";
}

/** @mainpage VssLoader Module

    @section vssloaderintro VssLoader Module Introduction

    The %VssLoader module provides core functionality for loading, parsing,
    and validating COVESA Vehicle Signal Specification (VSS) data. It is the
    foundation for the @ref vssdataproviderintro "VssDataProvider module" and can also be used
    independently for fleet management, IoT telemetry validation, and
    vehicle data processing.

    @section vssloaderquickstart Quick Start

    @code{.py}
    %requires VssLoader

    # Load a VSS catalog
    VssTree tree("/opt/fleet/catalogs/vss_rel_4.0.yaml");
    printf("Loaded %d signals\n", tree.size());

    # Look up signal metadata
    *hash<VssNode> speed = tree.getNode("Vehicle.Speed");
    printf("Speed: unit=%s, range=[%y, %y]\n", speed.unit, speed.min, speed.max);

    # Validate telemetry data from fleet vehicles
    VssValidator validator(tree);
    list<hash<VssValidationError>> errors = validator.validateRecord({
        "Vehicle.Speed": 85,
        "Vehicle.Powertrain.CombustionEngine.ECT": 90,
    });
    printf("Valid: %y\n", errors.empty());

    # Convert units for multi-region fleet dashboards
    VssUnitConverter converter();
    float mph = converter.convert(100.0, "km/h", "mph");
    @endcode

    @section vssloaderclasses Classes

    - @ref VssLoader::VssVspecParser "VssVspecParser" - Native .vspec file parser with
      \c "#include" support
    - @ref VssLoader::VssTree "VssTree" - Resolved VSS signal tree with navigation and
      glob-based path queries
    - @ref VssLoader::VssInstanceExpander "VssInstanceExpander" - Expands instance
      specifications (e.g., Door[Row1,Row2][Left,Right]) into concrete paths
    - @ref VssLoader::VssOverlayMerger "VssOverlayMerger" - Merges VSS overlays for
      fleet-specific catalog customization
    - @ref VssLoader::VssValidator "VssValidator" - Validates signal values against
      type, range, and enum constraints
    - @ref VssLoader::VssUnitConverter "VssUnitConverter" - Extensible unit conversion
      with built-in automotive conversions

    @section vssloadertypes Type Definitions

    - @ref VssLoader::VssNode "VssNode" - Signal/branch node metadata
    - @ref VssLoader::VssValidationError "VssValidationError" - Validation error details
    - @ref VssLoader::VssUnitConversion "VssUnitConversion" - Unit conversion specification

    @section vssloader_caller_paths Paths Given by Restricted Callers

    The code of this module runs with its own %Program's options, so it decides with the restrictions of the code that
    calls it before it reads a file whose path that code gives: if that code is restricted from the \c FILESYSTEM
    functional domain (for example with \c PO_NO_FILESYSTEM), the call is refused with \c PERMISSION-DENIED before
    anything is read.  The file-system policy of a sandbox that governs the calling code applies when a file is opened
    (\c FILESYSTEM-ACCESS-DENIED).  The checked paths are:
    - the path given to the @ref VssLoader::VssTree::constructor(string) "VssTree" and
      @ref VssLoader::VssUnitConverter::constructor(string) "VssUnitConverter" constructors (the creating code is
      judged, see @ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()")
    - the path given to @ref VssLoader::VssVspecParser::parseFile() "VssVspecParser::parseFile()" and the files that
      the \c \#include directives of the content given to
      @ref VssLoader::VssVspecParser::parseContent() "VssVspecParser::parseContent()" name; here the code that a
      host-created parser was lent to is judged too (see @ref Qore::SandboxManager::isLentToRestricted()
      "SandboxManager::isLentToRestricted()")

    Objects created from data (@ref VssLoader::VssTree::constructor(hash<string, hash<VssNode>>, *string) "VssTree"
    from a node map, the default @ref VssLoader::VssUnitConverter "VssUnitConverter" and content without
    \c \#include directives) work for restricted callers.

    @subpage vssloaderreleasenotes
*/

/** @page vssloaderreleasenotes VssLoader Release Notes

    @section vssloaderv10 VssLoader Module Version 1.0
    - initial release
    - the file-system paths that the calling code gives are refused with \c PERMISSION-DENIED before they are used if
      the calling code is restricted from the file system (see @ref vssloader_caller_paths,
      <a href="https://github.com/qoretechnologies/module-vss/issues/4">issue 4</a>)
*/

public namespace VssLoader {
#! Refuses a file-system path given by the calling code if that code is restricted from the file system
/** Library code runs with its own %Program's options, so a path that the calling code gives is refused before it is
    used if that code is restricted from the \c FILESYSTEM functional domain (for example with \c PO_NO_FILESYSTEM);
    see @ref vssloader_caller_paths.

    @param what a description of the path, for the error message
    @param path the path; no check is made if it is not set (any value that is set is checked, also an empty string
    and one that evaluates to @ref False, such as \c "0")
    @param lent @ref True if the path is an argument of a method of an existing object, which a host can lend to
    restricted code (the borrower is judged, see @ref Qore::SandboxManager::isLentToRestricted()
    "SandboxManager::isLentToRestricted()"), @ref False if it is given when an object is created (the creating code is
    judged, see @ref Qore::SandboxManager::isCallerRestricted() "SandboxManager::isCallerRestricted()")

    @throw PERMISSION-DENIED the calling code is restricted from the \c FILESYSTEM functional domain
*/
sub vss_check_caller_path(string what, auto path, bool lent) {
    if (exists path && (lent
            ? SandboxManager::isLentToRestricted(DOM_FILESYSTEM)
            : SandboxManager::isCallerRestricted(DOM_FILESYSTEM))) {
        throw "PERMISSION-DENIED", sprintf("the %s cannot be used: the calling code is restricted from the FILESYSTEM "
            "functional domain", what);
    }
}
}
