%requires qore >= 2.0
%requires yaml
%requires json
%requires Util

%modern

module VssLoader {
    version = "1.0";
    desc = "COVESA Vehicle Signal Specification (VSS) loader and validator";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-vss";
    license = "MIT";
}

/** @mainpage VssLoader Module

    @section vssloaderintro Introduction

    The %VssLoader module provides core functionality for loading, parsing,
    and validating COVESA Vehicle Signal Specification (VSS) data.

    @section vssloaderclasses Classes

    - @ref VssLoader::VssVspecParser "VssVspecParser" - Native .vspec file parser
    - @ref VssLoader::VssTree "VssTree" - Resolved VSS signal tree
    - @ref VssLoader::VssInstanceExpander "VssInstanceExpander" - Instance expansion
    - @ref VssLoader::VssOverlayMerger "VssOverlayMerger" - Overlay merge operations
    - @ref VssLoader::VssValidator "VssValidator" - Signal data validator
    - @ref VssLoader::VssUnitConverter "VssUnitConverter" - Unit conversion
*/

public namespace VssLoader {
}
