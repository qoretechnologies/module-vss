Vehicle.Speed:
  type: sensor
  datatype: float
  unit: km/h
  min: 0
  max: 350
  description: "Vehicle speed (extended range for racing)."
  comment: "Extended max for high-performance vehicles"

Vehicle.Cabin.Humidity:
  type: sensor
  datatype: float
  unit: percent
  min: 0
  max: 100
  description: "Relative humidity inside the cabin."
