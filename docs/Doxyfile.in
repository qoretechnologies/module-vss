PROJECT_NAME = "Qore VSS Module"
PROJECT_NUMBER = "@PROJECT_VERSION@"
INPUT = "@CMAKE_BINARY_DIR@/mainpage.dox"
OUTPUT_DIRECTORY = "@CMAKE_BINARY_DIR@/docs/vss"
